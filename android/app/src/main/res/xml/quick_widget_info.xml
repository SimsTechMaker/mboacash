<?xml version="1.0" encoding="utf-8"?>
<!-- The app refreshes the widget itself when data changes: no periodic update. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/quick_widget_description"
    android:initialLayout="@layout/quick_widget"
    android:minWidth="180dp"
    android:minHeight="56dp"
    android:previewLayout="@layout/quick_widget"
    android:resizeMode="horizontal"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
